
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GameActivity">

    <!-- Animated ground -->
    <ImageView
        android:id="@+id/tilelayerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Custom gameplay rendering -->
    <com.angonogiants.application.GameView
        android:id="@+id/gameView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Foreground trees -->
    <ImageView
        android:id="@+id/treelayerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Timer -->
    <ImageView
        android:id="@+id/timerIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/timer_icon"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/start"
        android:text="05:00"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/timerIcon"
        app:layout_constraintBottom_toBottomOf="@id/timerIcon"
        app:layout_constraintStart_toEndOf="@id/timerIcon" />

    <!-- Score -->
    <ImageView
        android:id="@+id/swordIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/sword_icon"
        android:contentDescription="@null"
        app:layout_constraintTop_toBottomOf="@id/timerIcon"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/ScoreCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/start"
        android:text="Score: 0"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/swordIcon"
        app:layout_constraintBottom_toBottomOf="@id/swordIcon"
        app:layout_constraintStart_toEndOf="@id/swordIcon" />

    <!-- Level and current wave -->
    <TextView
        android:id="@+id/waveCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:fontFamily="@font/start"
        android:text="Level 1 - Wave 1"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pause button -->
    <ImageButton
        android:id="@+id/btnPauseResume"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_margin="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/pause_button_animation"
        android:contentDescription="Pause or Resume"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Defeat background -->
    <ImageView
        android:id="@+id/gameOverImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/gameoverskull_background"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Final defeat background -->
    <ImageView
        android:id="@+id/lostfinalscoreiv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/lostfinalscore_background"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Level complete background -->
    <ImageView
        android:id="@+id/gameThanksImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/gamewonthanks_background"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/gameThanksText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/slkscr"
        android:textAlignment="center"
        android:textColor="#401B13"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Reserved for future final victory screen -->
    <ImageView
        android:id="@+id/gameWonImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/wonfinalscore"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pause menu -->
    <ImageButton
        android:id="@+id/restartButton"
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:background="@drawable/restart_button_animation"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Restart Game"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.381" />

    <ImageButton
        android:id="@+id/menuButton"
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:background="@drawable/mainmenu_button_animation"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Main Menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <ImageButton
        android:id="@+id/exitButton"
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:background="@drawable/exit_button_animation"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Exit Game"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.616" />

    <!-- Scrollable final score -->
    <ScrollView
        android:id="@+id/finalScoreContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="105dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Player name -->
            <TextView
                android:id="@+id/playerNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/start"
                android:text="Player"
                android:textColor="@android:color/white"
                android:textSize="30sp"
                android:shadowColor="#21140E"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2" />

            <!-- Highest level reached in this run -->
            <TextView
                android:id="@+id/finalLevelTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/start"
                android:text="Level 1"
                android:textColor="#FFD700"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/finalTimerIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/timer_icon"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/start"
                    android:text="Time Played"
                    android:textColor="@android:color/white"
                    android:textSize="21sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/finalScoreTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/slkscr"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/finalSwordIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/sword_icon"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/start"
                    android:text="Score"
                    android:textColor="@android:color/white"
                    android:textSize="23sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/finalScoreTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/slkscr"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/finalwaveIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/higantes7top"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/start"
                    android:text="Total Waves"
                    android:textColor="@android:color/white"
                    android:textSize="23sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/finalwaveTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/slkscr"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="28sp" />

        </LinearLayout>

    </ScrollView>

    <!-- Final-score Main Menu -->
    <ImageButton
        android:id="@+id/mainMenuButton"
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/mainmenu_button_animation"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Return to Main Menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Intro animation overlay -->
    <ImageView
        android:id="@+id/gifOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:clickable="false"
        android:focusable="false"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
