<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/leaderboard_background"
    tools:context=".LeaderboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="50dp"
        android:layout_marginHorizontal="60dp">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/leaderboardTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Leaderboard"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:fontFamily="@font/start"
                android:layout_marginTop="25dp" />

            <ListView
                android:id="@+id/leaderboardListView"
                android:layout_width="match_parent"
                android:layout_height="2000dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>

    </LinearLayout>

    <ImageButton
        android:id="@+id/mainMenuLButton"
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/mainmenu_button_animation"
        android:contentDescription="move to main menu"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        android:scaleType="fitCenter">
    </ImageButton>


</RelativeLayout>