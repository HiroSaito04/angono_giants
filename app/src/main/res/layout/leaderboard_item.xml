<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Medal Container (Visible only for Top 3) -->
    <LinearLayout
        android:id="@+id/medalContainer"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="gone"> <!-- Hidden for non-placers -->

        <ImageView
            android:id="@+id/medalgold"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:visibility="gone"
            android:src="@drawable/medal1gold"/>

        <ImageView
            android:id="@+id/medalzilver"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:visibility="gone"
            android:src="@drawable/medal2zilver"/>

        <ImageView
            android:id="@+id/medalbronze"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:visibility="gone"
            android:src="@drawable/medal3bronze"/>
    </LinearLayout>

    <!-- Player Info Container -->
    <LinearLayout
        android:id="@+id/playerInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"> <!-- Center text for non-placers -->

        <TextView
            android:id="@+id/playerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Player Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/slkscr"
            android:textColor="#81645C"/>

        <TextView
            android:id="@+id/playerScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score"
            android:textSize="16sp"
            android:fontFamily="@font/slkscr"
            android:textColor="#81645C"/>

        <TextView
            android:id="@+id/wavesSurvived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waves Survived"
            android:textSize="16sp"
            android:fontFamily="@font/slkscr"
            android:textColor="#81645C"/>

        <TextView
            android:id="@+id/timePlayed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time Played"
            android:textSize="16sp"
            android:fontFamily="@font/slkscr"
            android:textColor="#81645C"/>
    </LinearLayout>

</LinearLayout>
