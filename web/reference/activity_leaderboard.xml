<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/leaderboard_background"
    tools:context=".LeaderboardActivity">

    <LinearLayout
        android:id="@+id/leaderboardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/mainMenuLButton"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/leaderboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/start"
            android:gravity="center"
            android:text="HIGHEST LEVEL RANKINGS"
            android:textColor="#81645C"
            android:textSize="23sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/leaderboardListView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="30dp"
                android:background="@android:color/transparent"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/emptyLeaderboardText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="18dp"
                android:fontFamily="@font/slkscr"
                android:text="No scores yet. Be the first to climb the levels!"
                android:textColor="#81645C"
                android:textSize="18sp" />

        </FrameLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/mainMenuLButton"
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="18dp"
        android:background="@drawable/mainmenu_button_animation"
        android:contentDescription="Return to Main Menu"
        android:scaleType="fitCenter" />

</RelativeLayout>
