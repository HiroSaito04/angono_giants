<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="#20FFFFFF">

    <LinearLayout
        android:id="@+id/medalContainer"
        android:layout_width="64dp"
        android:layout_height="70dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:id="@+id/medalgold"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/medal1gold"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Gold medal" />

        <ImageView
            android:id="@+id/medalzilver"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/medal2silver"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Silver medal" />

        <ImageView
            android:id="@+id/medalbronze"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/medal3bronze"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Bronze medal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/playerInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="5dp"
        android:paddingEnd="5dp">

        <TextView
            android:id="@+id/playerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Player"
            android:textColor="#81645C"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFamily="@font/slkscr"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/playerLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="LEVEL 1"
            android:textColor="#6B4536"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="@font/slkscr" />

        <TextView
            android:id="@+id/playerScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SCORE: 0"
            android:textColor="#81645C"
            android:textSize="15sp"
            android:fontFamily="@font/slkscr" />

        <TextView
            android:id="@+id/wavesSurvived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WAVES: 0"
            android:textColor="#81645C"
            android:textSize="14sp"
            android:fontFamily="@font/slkscr" />

        <TextView
            android:id="@+id/timePlayed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TIME: 0 seconds"
            android:textColor="#81645C"
            android:textSize="14sp"
            android:fontFamily="@font/slkscr" />

    </LinearLayout>

</LinearLayout>